[
  {
    "name": "search_shows",
    "description": "Search TV shows by name. Returns shows with id, name, premiere date, network, genres, rating, status, and TVMaze URL.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "query": {
          "type": "string",
          "description": "Show name (full or partial)"
        }
      },
      "required": [
        "query"
      ]
    }
  },
  {
    "name": "get_show",
    "description": "Fetch a full show record by TVMaze ID. Optionally embed episodes, cast, seasons, or previous/next episode info for richer responses.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "show_id": {
          "type": "number",
          "description": "TVMaze show ID"
        },
        "embed_episodes": {
          "type": "boolean",
          "description": "Include full episode list"
        },
        "embed_cast": {
          "type": "boolean",
          "description": "Include cast"
        },
        "embed_seasons": {
          "type": "boolean",
          "description": "Include season metadata"
        }
      },
      "required": [
        "show_id"
      ]
    }
  },
  {
    "name": "list_episodes",
    "description": "List all episodes of a show. Returns season, number, name, airdate, runtime, and summary.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "show_id": {
          "type": "number",
          "description": "TVMaze show ID"
        },
        "specials": {
          "type": "boolean",
          "description": "Include special episodes (default false)"
        }
      },
      "required": [
        "show_id"
      ]
    }
  },
  {
    "name": "get_schedule",
    "description": "What TV shows are airing on a given day in a country. Useful for \"what aired last night on UK TV\". Returns episode + show records.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "country": {
          "type": "string",
          "description": "2-letter country code (default \"US\")"
        },
        "date": {
          "type": "string",
          "description": "YYYY-MM-DD (default today)"
        }
      },
      "required": []
    }
  },
  {
    "name": "search_people",
    "description": "Search TVMaze's actor/person database by name. Returns matched people with id, name, country code, birthday, deathday, gender, and headshot image URL.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "query": {
          "type": "string",
          "description": "Person name"
        }
      },
      "required": [
        "query"
      ]
    }
  }
